# Required: OpenAI API key for the existing chat + embedding models
OPENAI_API_KEY=sk-proj-Abcd1234
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Required: Pinecone API key (create a key in the Pinecone console)
PINECONE_API_KEY=pcsk_6t98
PINECONE_INDEX_NAME=multimodal-rag-vectors
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_METRIC=cosine

# Persistence paths inside the backend container
RAG_STORAGE_DIR=./rag_storage
SQLITE_DB_PATH=./rag_storage/rag_app.db

# Comma-separated allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
